{
  "expo": {
    "name": "frogups",
    "slug": "frogups",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app/icon.png",
    "scheme": "frogups",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app/icon.png"
    },
    "android": {
      "package": "com.frogups.frogups",
      "adaptiveIcon": {
        "backgroundColor": "#1f3d1f",
        "foregroundImage": "./assets/images/app/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1f3d1f",
          "image": "./assets/images/app/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9c631d3c-9d63-4d72-8005-bcdb064d1914"
      }
    },
    "owner": "frogups"
  }
}
